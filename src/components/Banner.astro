<script>
  import lottie from 'lottie-web'

  document.addEventListener('DOMContentLoaded', () => {
    let currentAnimation = null
    const backgroundContainer = document.getElementById('lottieBackground')

    const loadResponsiveAnimation = () => {
      const windowWidth = window.innerWidth

      let animationPath
      if (windowWidth > 1024) {
        animationPath = './animation/data_web.json'
      } else if (windowWidth > 640) {
        animationPath = './animation/data_pad.json'
      } else {
        animationPath = './animation/data_mobile.json'
      }

      if (currentAnimation) {
        currentAnimation.destroy()
      }

      if (backgroundContainer) {
        currentAnimation = lottie.loadAnimation({
          container: backgroundContainer,
          renderer: 'svg',
          loop: true,
          autoplay: true,
          path: animationPath,
        })
      }
    }

    loadResponsiveAnimation()

    let resizeTimeout
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout)
      resizeTimeout = setTimeout(loadResponsiveAnimation, 200)
    })
  })
</script>

<style lang="scss">
  @use '../style/_variable.scss' as *;
  .banner {
    width: 100%;
    justify-content: center;
    align-items: center;
    position: relative;
    aspect-ratio: 16 / 9;
  }
  .banner__animation {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .banner__contents {
    position: absolute;
    top: 35%;
    left: 15%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: fit-content;
    @media screen and (max-width: 1600px) {
      left: 10%;
    }
    @media screen and (max-width: 1024px) {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -150%);
    }
    @media screen and (max-width: 768px) {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -140%);
    }
    @media screen and (max-width: 640px) {
      top: 50%;
      left: 20%;
      transform: translate(-13%, -140%);
    }
    @media screen and (max-width: 460px) {
      top: 54%;
      // transform: translate(-20%, -140%);
    }
    @media screen and (max-width: 360px) {
      top: 56%;
      left: 17%;
      transform: translate(-10%, -140%);
    }
    &-l {
      display: flex;
      flex-direction: column;
      .banner__title {
        margin-bottom: 20px;
        @media screen and (max-width: 1600px) {
          margin-bottom: 10px;
        }
        @media screen and (max-width: 1280px) {
          margin-bottom: 0px;
        }

        @media screen and (max-width: 390px) {
          margin-bottom: -6%;
        }
      }
      svg {
        width: 100%;
        @media screen and (max-width: 1440px) {
          width: 80%;
        }
        @media screen and (max-width: 1280px) {
          width: 75%;
        }
        @media screen and (max-width: 1024px) {
          width: 100%;
        }
        @media screen and (max-width: 460px) {
          width: 85%;
        }
      }
      .banner__subtitle {
        display: flex;
        align-items: center;
        &-text {
          font-size: clamp(28px, 3vw, 48px);
          color: $whiteColor;
          font-weight: 600;
        }
        .banner__mouse {
          margin-left: 8px;
          margin-top: 4px;
          @media screen and (max-width: 1024px) {
            margin-top: 20px;
            width: 30px;
          }
        }
      }
    }
  }
</style>
