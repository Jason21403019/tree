<style lang="scss">
  @import '../style/_variable.scss';
  .footer {
    margin-bottom: 108px;
    @media screen and (max-width: 1024px) {
      margin-bottom: 0px;
    }
    &__table {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      margin-bottom: 30px;

      &-row {
        margin-bottom: 0.5rem;

        &--logos {
          margin-bottom: 2rem;
        }
      }

      &-cell {
        padding: 0.5rem;

        &--right {
          text-align: right;
          font-size: 16px;
          color: $articleColor;
          width: 50%;
        }

        &--left {
          text-align: left;
          font-size: 16px;
          color: $articleColor;
          width: 50%;
        }

        &--logo {
          text-align: center;
          padding: 1rem 0.5rem;

          &.footer__table-cell--right {
            text-align: right;
          }

          &.footer__table-cell--left {
            text-align: left;
          }
        }
      }
    }
    &__logos {
      &-logo1,
      &-logo2 {
        display: inline-block;

        img {
          max-width: 100%;
        }
      }
    }

    &__links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 8px;

      &-link {
        font-size: 16px;
        color: $articleColor;
        text-decoration: none;
      }
      &-link2 {
        position: relative;
        &::before {
          content: '';
          position: absolute;
          left: -0.75rem;
          top: 50%;
          transform: translateY(-45%);
          height: 16px;
          width: 1px;
          background-color: $articleColor;
        }
        &::after {
          content: '';
          position: absolute;
          right: -0.75rem;
          top: 50%;
          transform: translateY(-45%);
          height: 16px;
          width: 1px;
          background-color: $articleColor;
        }
      }
    }
    &__copyright {
      p {
        text-align: center;
        font-size: 14px;
        color: $articleColor;
      }
    }
  }
</style>
