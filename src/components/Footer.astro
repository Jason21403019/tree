<style lang="scss">
  @use '../style/_variable.scss' as *;
  .footer {
    margin-bottom: 108px;
    @media screen and (max-width: 1280px) {
      margin-bottom: 0px;
    }

    &__logos-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
      max-width: 900px;
      // margin: 0 auto;
      margin-bottom: 2rem;
      margin-left: auto;
      margin-right: auto;

      @media screen and (max-width: 870px) {
        max-width: 600px;
        gap: 0;
        justify-content: space-evenly;
        margin-bottom: 0rem;
      }
    }

    &__logos-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;

      img {
        max-width: 100%;
        max-height: 40px;
        display: block;
      }

      @media screen and (max-width: 870px) {
        width: calc(50% - 1.5rem);
        margin-bottom: 1rem;

        &:nth-child(odd) {
          justify-content: flex-end;
        }

        &:nth-child(even) {
          justify-content: flex-start;
        }

        img {
          max-height: 50px;
        }
      }
      @media screen and (max-width: 480px) {
        width: 100%;
        margin-bottom: 1rem;
        &:nth-child(odd) {
          justify-content: center;
          align-items: center;
        }

        &:nth-child(even) {
          justify-content: center;
          align-items: center;
        }
      }
    }
    &__table {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      margin-bottom: 30px;

      &-row {
        margin-bottom: 0.5rem;

        &--logos {
          margin-bottom: 2rem;
        }
      }

      &-cell {
        padding: 0.5rem;

        &--right {
          text-align: right;
          font-size: 16px;
          color: $articleColor;
          width: 50%;
        }

        &--left {
          text-align: left;
          font-size: 16px;
          color: $articleColor;
          width: 50%;
        }

        &--logo {
          text-align: center;
          padding: 0.5rem 0.5rem;

          &.footer__table-cell--right {
            text-align: right;
          }

          &.footer__table-cell--left {
            text-align: left;
          }
        }
      }
    }

    &__links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 8px;

      &-link {
        font-size: 16px;
        color: $articleColor;
        text-decoration: none;
      }
      &-link2 {
        position: relative;
        &::before {
          content: '';
          position: absolute;
          left: -0.75rem;
          top: 50%;
          transform: translateY(-45%);
          height: 16px;
          width: 1px;
          background-color: $articleColor;
        }
        &::after {
          content: '';
          position: absolute;
          right: -0.75rem;
          top: 50%;
          transform: translateY(-45%);
          height: 16px;
          width: 1px;
          background-color: $articleColor;
        }
      }
    }
    &__copyright {
      p {
        text-align: center;
        font-size: 14px;
        color: $articleColor;
      }
    }
  }
</style>
