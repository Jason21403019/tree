---

<header class="header">
  <nav class="nav">
    <div class="nav__logo">
      <a href="/" class="nav__logo-img">
        <img src="/public/imgs/LOGO.svg" alt="LOGO" class="nav__logo-img" />
      </a>
    </div>
    <ul class="nav__list" id="nav-list">
      <li class="nav__item">
        <a href="/#promise" class="nav__link">永續承諾</a>
      </li>
      <li class="nav__item">
        <a href="/#plants" class="nav__link">步步換樹</a>
      </li>
      <li class="nav__item">
        <a href="/#action" class="nav__link">實踐行動</a>
      </li>
      <li class="nav__item">
        <a href="/#partners" class="nav__link">共好夥伴</a>
      </li>
    </ul>
    <div class="nav__hamburger" id="hamburger">
      <span class="nav__hamburger-line"></span>
      <span class="nav__hamburger-line"></span>
      <span class="nav__hamburger-line"></span>
    </div>
  </nav>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.getElementById('hamburger')
    const navList = document.getElementById('nav-list')

    const navItems = navList?.querySelectorAll('.nav__item')

    const toggleMenu = () => {
      hamburger?.classList.toggle('active')
      navList?.classList.toggle('active')
      document.body.classList.toggle('no-scroll')
    }

    hamburger?.addEventListener('click', (event) => {
      event.stopPropagation()
      toggleMenu()
    })

    navList?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement

      if (target.tagName === 'A') {
        const href = target.getAttribute('href')
        if (href && href.includes('#')) {
          const currentPath = window.location.pathname
          const targetPath = href.split('#')[0] || '/'

          if (
            currentPath === targetPath ||
            (currentPath === '/' && targetPath === '/')
          ) {
            event.preventDefault()
            const targetId = href.split('#')[1]
            const targetElement = document.getElementById(targetId)

            if (targetElement) {
              targetElement.scrollIntoView({ behavior: 'smooth' })
            }
          }
        }
      }
      if (target === navList || window.innerWidth <= 1024) {
        toggleMenu()
        return
      }

      let clickedOnItem = false
      navItems?.forEach((item) => {
        if (item === target || item.contains(target)) {
          clickedOnItem = true
        }
      })

      if (!clickedOnItem && target !== hamburger) {
        toggleMenu()
      }
    })
  })
</script>

<style lang="scss">
  @import '../style/_variable.scss';
  .header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 999;
    height: 65px;
    display: flex;
    justify-content: center;
    background: $webBGColor;
    // border: 1px solid green;
  }
  .nav {
    height: 100%;
    width: 100%;
    max-width: 1765px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    position: relative;

    &__logo {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      // border: 1px solid red;
      @media screen and (max-width: 1780px) {
        margin-left: 10px;
      }

      &-img {
        display: block;
        width: 100%;
        height: 100%;
      }
    }

    &__list {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      justify-content: center;
      align-items: center;

      @media screen and (max-width: 1024px) {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        transform: translateX(-100%);
        transition:
          transform 0.5s ease,
          opacity 0.5s ease,
          visibility 0.5s ease;
        z-index: 999;
        opacity: 0;
        visibility: hidden;
        padding-top: 80px;

        &.active {
          transform: translateX(0);
          opacity: 1;
          visibility: visible;
        }
      }
    }

    &__item {
      height: 100%;
      display: flex;
      align-items: center;

      @media screen and (max-width: 1024px) {
        width: 100%;
        height: 10%;
        text-align: center;
      }
      &:nth-child(2),
      &:nth-child(3) {
        margin: 0 10px;
      }
    }

    &__link {
      padding: 20px;
      width: 100%;
      height: 100%;
      text-decoration: none;
      color: $fontColor;

      @media screen and (max-width: 1024px) {
        position: relative;
        display: block;

        &::after {
          content: '';
          position: absolute;
          left: 60px;
          right: 60px;
          bottom: 15px;
          width: calc(100% - 120px);
          height: 1px;
          background-color: $fontColor;
        }
      }
    }
    &__hamburger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 28px;
      height: 18px;
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      z-index: 1000;

      @media screen and (max-width: 1024px) {
        display: flex;
      }

      &-line {
        display: block;
        width: 28px;
        height: 1px;
        background-color: #000;
        transition: all 0.3s ease-in-out;
      }

      &.active {
        .nav__hamburger-line {
          &:nth-child(1) {
            transform: translateY(8px) rotate(45deg);
          }

          &:nth-child(2) {
            opacity: 0;
          }

          &:nth-child(3) {
            transform: translateY(-8px) rotate(-45deg);
          }
        }
      }
    }
  }
</style>
