<header class="header">
  <div class="header__container">
    <nav class="nav">
      <!-- <div class="nav__logo">
        <a href="/" class="nav__logo-img">
          <img
            src="./imgs/logo.svg"
            alt="LOGO"
            class="nav__logo-img"
            width="178"
          />
        </a>
      </div> -->
      <ul class="nav__list" id="nav-list">
        <li class="nav__item">
          <a href="#promise" class="nav__link">永續承諾</a>
        </li>
        <li class="nav__item">
          <a href="#plants" class="nav__link">步步換樹</a>
        </li>
        <li class="nav__item">
          <a href="#action" class="nav__link">活動資訊</a>
        </li>
        <li class="nav__item">
          <a href="#video" class="nav__link">實踐行動</a>
        </li>
        <li class="nav__item">
          <a href="#partners" class="nav__link">共好夥伴</a>
        </li>
      </ul>
      <div class="nav__hamburger" id="hamburger">
        <span class="nav__hamburger-line"></span>
        <span class="nav__hamburger-line"></span>
        <span class="nav__hamburger-line"></span>
      </div>
    </nav>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const hamburger = document.getElementById('hamburger')
    const navList = document.getElementById('nav-list')
    const navItems = navList?.querySelectorAll('.nav__item')

    const setActiveItem = () => {
      const currentHash = window.location.hash || ''
      const currentPath = window.location.pathname

      navItems?.forEach((item) => {
        const link = item.querySelector('a')
        const href = link?.getAttribute('href')

        if (href) {
          item.classList.remove('active')

          if (
            (href.includes('#') && currentHash && href.endsWith(currentHash)) ||
            (currentPath === href && !href.includes('#'))
          ) {
            item.classList.add('active')
          }
        }
      })
    }

    setActiveItem()

    window.addEventListener('hashchange', setActiveItem)

    const toggleMenu = () => {
      hamburger?.classList.toggle('active')
      navList?.classList.toggle('active')
    }

    hamburger?.addEventListener('click', (event) => {
      event.stopPropagation()
      toggleMenu()
    })

    navList?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement

      if (target.tagName === 'A') {
        const href = target.getAttribute('href')
        if (href && href.includes('#')) {
          const currentPath = window.location.pathname
          const targetPath = href.split('#')[0]
          if (currentPath === targetPath) {
            event.preventDefault()
            const targetId = href.split('#')[1]
            const targetElement = document.getElementById(targetId)

            if (targetElement) {
              history.pushState(null, '', '#' + targetId)

              targetElement.scrollIntoView({ behavior: 'smooth' })

              setActiveItem()
            }
          }
        }
      }

      if (target === navList || window.innerWidth <= 1024) {
        toggleMenu()
        return
      }

      let clickedOnItem = false
      navItems?.forEach((item) => {
        if (item === target || item.contains(target)) {
          clickedOnItem = true
        }
      })

      if (!clickedOnItem && target !== hamburger) {
        toggleMenu()
      }
    })
  })
</script>

<style lang="scss">
  @use '../style/_variable.scss' as *;
  .header {
    // border: 1px solid red;
    position: sticky;
    top: 0;
    left: 0;
    max-width: 1765px;
    width: 100%;
    z-index: 999;
    height: 65px;
    display: flex;
    margin: 0 auto;
    justify-content: center;
    background: $webBGColor;
    @media screen and (max-width: 1278px) {
      max-width: 100% !important;
    }

    &__container {
      width: 100%;
      max-width: 1765px;
    }
  }
  .nav {
    height: 100%;
    width: 100%;
    max-width: 1765px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    position: relative;

    &__logo {
      position: absolute;
      left: 0;
      top: 50%;
      height: 100%;
      transform: translateY(-50%);

      @media screen and (max-width: 1278px) {
        margin-left: 10px !important;
      }

      &-img {
        display: block;
        width: 178px;
        height: 100%;
      }
    }

    &__list {
      width: 100%;
      height: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
      display: flex;
      justify-content: center;
      align-items: center;
      @media screen and (max-width: 1024px) {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        transform: translateX(-100%);
        transition:
          transform 0.85s ease,
          opacity 0.85s ease,
          visibility 0.85s ease;
        z-index: 999;
        opacity: 0;
        visibility: hidden;
        padding-top: 80px;

        &.active {
          transform: translateX(0);
          opacity: 1;
          visibility: visible;
          border-radius: 0;
        }
      }
    }

    &__item {
      height: 100%;
      display: flex;
      align-items: center;
      position: relative;
      transition: all 0.3s ease;
      cursor: pointer;

      @media screen and (max-width: 1024px) {
        width: 100%;
        height: 10%;
        text-align: center;
        &.active {
          &::before,
          &::after {
            display: none;
          }
        }
      }
      @media screen and (max-width: 480px) {
        @media (orientation: landscape) {
          height: 20%;
        }
      }
      &:nth-child(even) {
        margin: 0 10px;
      }
    }

    &__link {
      padding: 20px;
      width: 100%;
      height: 100%;
      text-decoration: none;
      font-size: 16px;
      color: $fontColor;
      &.active {
        color: $mainColor;
      }

      @media screen and (max-width: 1024px) {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 35px 10px 0px 10px;
        border-bottom: 1px solid #000;
        margin: 0 30px;
        @media (orientation: landscape) {
          padding-top: 15px;
          margin: 0 20px;
        }
      }
    }
    &__hamburger {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 28px;
      height: 18px;
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      z-index: 1000;

      @media screen and (max-width: 1024px) {
        display: flex;
      }

      &-line {
        display: block;
        width: 28px;
        height: 1px;
        background-color: #000;
        transition: all 0.4s ease-in-out;
      }

      &.active {
        transition: all 0.2s ease-in-out;
        transition-delay: 0.6s;
        transform: translateY(-50%);

        .nav__hamburger-line {
          &:nth-child(2) {
            transform: scale(0);
          }

          &:nth-child(1),
          &:nth-child(3) {
            transition-delay: 0.4s;
          }

          &:nth-child(1) {
            transform: translateY(8px) rotate(-135deg);
          }

          &:nth-child(3) {
            transform: translateY(-8px) rotate(135deg);
          }
        }
      }
    }
  }
</style>
