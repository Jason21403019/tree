          }
        }
        .button-container {
          position: absolute;
          bottom: 0;
          right: 0;

          a {
            display: block;
            cursor: pointer;

            img {
              margin-bottom: -2%;
              display: block;
              width: 50px;
              @media screen and (max-width: 1024px) {
                width: 40px;
              }
            }
          }
        }
      }
      &-img {
        flex: 0 1 50%;
        @media screen and (max-width: 1024px) {
          order: 1;
        }
        img {
          width: 100%;
          height: 100%;
        }
      }
    }
  }

  @keyframes borderGrow {
    0% {
      transform: scaleX(0);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes scaleRotateIn {
    0% {
      opacity: 0;
      transform: scale(0) rotate(-180deg);
    }
    70% {
      opacity: 1;
      transform: scale(1.1) rotate(10deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
</style>
