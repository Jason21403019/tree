          display: -webkit-box;
          -webkit-line-clamp: 3;
          -webkit-box-orient: vertical;
          overflow: hidden;
          text-overflow: ellipsis;
          max-height: calc(15px * 2 * 2 + 40px);
          @media screen and (max-width: 1024px) {
