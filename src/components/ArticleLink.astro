<section class="articleLink">
  <div class="articleLink__container">
    <div class="articleLink__content-l">
      <div class="articleLink__content-l-img">
        <img
          data-aos="zoom-in"
          data-aos-duration="1000"
          src="./imgs/left_plant.jpg"
          alt="left_plant"
        />
      </div>
      <div class="articleLink__content-l-content scroll-reveal">
        <h2 data-aos="fade-up" data-aos-duration="1200">2025.04.29</h2>
        <h1 data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200">
          企業助力植樹 共建碳中和未來
        </h1>
        <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400">
          第一堂樹木識別課程，老師請大家寫下認識的樹種。她認識的樹只有橘子、柚子、蘋果和葡萄樹，其中葡萄還不是樹，是藤本植物，讓她當
        </p>
        <div class="button-container">
          <a href="#" class="slide-fade-in">
            <img src="./imgs/seemore_big.svg" alt="seemorebtn" />
          </a>
        </div>
      </div>
    </div>
    <div class="articleLink__content-r">
      <div class="articleLink__content-r-content scroll-reveal">
        <h2 data-aos="fade-up" data-aos-duration="1200">2025.04.29</h2>
        <h1 data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200">
          企業助力植樹 共建碳中和未來
        </h1>
        <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400">
          第一堂樹木識別課程，老師請大家寫下認識的樹種。她認識的樹只有橘子、柚子、蘋果和葡萄樹，其中葡萄還不是樹，是藤本植物，讓她當
        </p>
        <div class="button-container">
          <a href="#" class="slide-fade-in">
            <img src="./imgs/seemore_big.svg" alt="seemorebtn" />
          </a>
        </div>
      </div>
      <div class="articleLink__content-r-img">
        <img
          data-aos="zoom-in"
          data-aos-duration="1000"
          src="./imgs/right_plant.jpg"
          alt="left_plant"
        />
      </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const elements = document.querySelectorAll('.scroll-reveal')

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active')
            observer.unobserve(entry.target)
          }
        })
      },
      {
        threshold: 0.2,
        rootMargin: '0px',
      }
    )

    elements.forEach((el) => observer.observe(el))
  })
</script>
<style lang="scss">
  @import '../style/_variable.scss';

  .articleLink {
    width: 100%;
    padding-bottom: 90px;
    @media screen and (max-width: 480px) {
      padding-bottom: 0px;
    }
    &__container {
      @media screen and (max-width: 1024px) {
        display: flex;
      }
      @media screen and (max-width: 768px) {
        flex-direction: column;
      }
    }
    &__content-l {
      display: flex;
      margin-bottom: 24px;
      @media screen and (max-width: 1024px) {
        flex-direction: column;
        margin-bottom: 0;
      }
      @media screen and (max-width: 768px) {
        margin-bottom: 24px;
      }
      &-img {
        flex: 0 1 50%;
        img {
          width: 100%;
          height: 100%;
        }
      }
      &-content {
        flex: 0 1 50%;
        margin-left: 32px;
        display: flex;
        flex-direction: column;
        position: relative;
        @media screen and (max-width: 1024px) {
          margin-left: 0;
        }

        &.scroll-reveal {
          &::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            height: 1px;
            width: 93%;
            background-color: $fontColor;
            transform-origin: left center;
            transform: scaleX(0);
            animation: none;
            will-change: transform;
          }

          &.active::after {
            animation: borderGrow 1.5s cubic-bezier(0.215, 0.61, 0.355, 1)
              forwards;
          }

          .button-container a.slide-fade-in {
            opacity: 0;
            transform: scale(0) rotate(-180deg);
            animation: none;
            will-change: transform, opacity;
          }

          &.active .button-container a.slide-fade-in {
            animation: scaleRotateIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)
              forwards;
            animation-delay: 0.8s;
          }
        }

        h2 {
          font-size: 15px;
          color: $mainColor;
          margin-bottom: 24px;
        }
        h1 {
          font-size: 21px;
          font-weight: 600;
          color: $fontColor;
          margin-bottom: 24px;
        }
        p {
          font-size: 15px;
          color: $articleColor;
          margin-bottom: 24px;
          text-align: justify;
          line-height: 2;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
          text-overflow: ellipsis;
          max-height: calc(15px * 2 * 2);
          @media screen and (max-width: 1024px) {
            margin-bottom: 74px;
          }
        }
        .button-container {
          position: absolute;
          bottom: 0;
          right: 0;

          a {
            display: block;
            cursor: pointer;

            img {
              margin-bottom: -2%;
              display: block;
              width: 50px;
              @media screen and (max-width: 1024px) {
                width: 40px;
              }
            }
          }
        }
      }
    }
    &__content-r {
      display: flex;
      @media screen and (max-width: 1024px) {
        flex-direction: column;
        margin-left: 18px;
        margin-bottom: 0;
      }
      @media screen and (max-width: 768px) {
        margin-left: 0;
      }
      &-content {
        flex: 0 1 50%;
        margin-right: 32px;
        display: flex;
        flex-direction: column;
        position: relative;
        @media screen and (max-width: 1024px) {
          order: 2;
          margin-right: 0;
        }
        &.scroll-reveal {
          &::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            height: 1px;
            width: 93%;
            background-color: $fontColor;
            transform-origin: left center;
            transform: scaleX(0);
            animation: none;
            will-change: transform;
          }

          &.active::after {
            animation: borderGrow 1.5s cubic-bezier(0.215, 0.61, 0.355, 1)
              forwards;
          }

          .button-container a.slide-fade-in {
            opacity: 0;
            transform: scale(0) rotate(-180deg);
            animation: none;
            will-change: transform, opacity;
          }

          &.active .button-container a.slide-fade-in {
            animation: scaleRotateIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)
              forwards;
            animation-delay: 0.8s;
          }
        }

        h2 {
          font-size: 15px;
          color: $mainColor;
          margin-bottom: 24px;
        }
        h1 {
          font-size: 21px;
          font-weight: 600;
          color: $fontColor;
          margin-bottom: 24px;
        }
        p {
          font-size: 15px;
          color: $articleColor;
          margin-bottom: 24px;
          text-align: justify;
          line-height: 2;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;
          overflow: hidden;
          text-overflow: ellipsis;
          max-height: calc(15px * 2 * 2);
          @media screen and (max-width: 1024px) {
            margin-bottom: 74px;
          }
        }
        .button-container {
          position: absolute;
          bottom: 0;
          right: 0;

          a {
            display: block;
            cursor: pointer;

            img {
              margin-bottom: -2%;
              display: block;
              width: 50px;
              @media screen and (max-width: 1024px) {
                width: 40px;
              }
            }
          }
        }
      }
      &-img {
        flex: 0 1 50%;
        @media screen and (max-width: 1024px) {
          order: 1;
        }
        img {
          width: 100%;
          height: 100%;
        }
      }
    }
  }

  @keyframes borderGrow {
    0% {
      transform: scaleX(0);
    }
    100% {
      transform: scaleX(1);
    }
  }

  @keyframes scaleRotateIn {
    0% {
      opacity: 0;
      transform: scale(0) rotate(-180deg);
    }
    70% {
      opacity: 1;
      transform: scale(1.1) rotate(10deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
</style>
