<section class="articleLink">
  <div class="articleLink__container">
    <div class="articleLink__content-l">
      <div class="articleLink__content-l-img">
        <img
          data-aos="zoom-in"
          data-aos-duration="1000"
          src="./imgs/left_plant.jpg"
          alt="left_plant"
        />
      </div>
      <div class="articleLink__content-l-content scroll-reveal">
        <h2 data-aos="fade-up" data-aos-duration="1200">2025.04.22</h2>
        <h1 data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200">
          環境與職場健康 為自然生態邁步前行
        </h1>
        <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400">
          植樹造林是恢復生態的解方，透過種植耐鹽、耐旱的台灣原生海岸樹種，不只提升生物多樣性，還能塑造多元地貌，提供沿岸生物更多棲地。
          聯合線上攜手高雄市愛種樹協會、健康促進軟體Walkii，邀請企業夥伴健走又種樹，將步數轉換為台灣原生樹苗，不僅促進職場健康，也前往茄萣公14種樹，讓這片受創土地成為生機盎然的「海角新樂園」。
        </p>
        <div class="button-container">
          <a
            href="https://ubrand.udn.com/ubrand/story/123930/8689920"
            class="slide-fade-in"
            target="_blank"
          >
            <img src="./imgs/seemore_big.svg" alt="seemorebtn" />
          </a>
        </div>
      </div>
    </div>
    <div class="articleLink__content-r">
      <div class="articleLink__content-r-content scroll-reveal">
        <h2 data-aos="fade-up" data-aos-duration="1200">2025.05.13</h2>
        <h1 data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200">
          延續過往行動 走路又種樹共創新模式
        </h1>
        <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400">
          2025年，聯合線上「與樹同行．走出一座健康森林」永續行動，與各界夥伴、超過250人共同為職場健康邁出3,800萬步，並為地球種下132棵樹。
          在過去，我們不僅在台東、桃園、高雄等地種下原生樹種，更前進東北角海域投入珊瑚復育，今年適逢世界地球日55週年，願今年「與樹同行」能成為綠色動能，持續為下一世代打造永續未來。
        </p>
        <div class="button-container">
          <a
            href="https://ubrand.udn.com/ubrand/story/123652/8735837"
            class="slide-fade-in"
            target="_blank"
          >
            <img src="./imgs/seemore_big.svg" alt="seemorebtn" />
          </a>
        </div>
      </div>
      <div class="articleLink__content-r-img">
        <img
          data-aos="zoom-in"
          data-aos-duration="1000"
          src="./imgs/right_plant.jpg"
          alt="left_plant"
        />
      </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const elements = document.querySelectorAll('.scroll-reveal')

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active')
            observer.unobserve(entry.target)
          }
        })
      },
      {
        threshold: 0.2,
        rootMargin: '0px',
      }
    )

    elements.forEach((el) => observer.observe(el))
  })
</script>
<style lang="scss">
  @use '../style/_variable.scss' as *;

  .articleLink {
    width: 100%;
    padding-bottom: 90px;
    @media screen and (max-width: 480px) {
      padding-bottom: 0px;
    }
    &__container {
      @media screen and (max-width: 1024px) {
        display: flex;
      }
      @media screen and (max-width: 768px) {
        flex-direction: column;
      }
    }
    &__content-l {
      display: flex;
      margin-bottom: 24px;
      @media screen and (max-width: 1024px) {
        flex-direction: column;
        margin-bottom: 0;
      }
      @media screen and (max-width: 768px) {
        margin-bottom: 24px;
      }
      &-img {
        flex: 0 1 50%;
        img {
          width: 100%;
          height: 100%;
        }
      }
      &-content {
        flex: 0 1 50%;
        margin-left: 32px;
        display: flex;
        flex-direction: column;
        position: relative;
        @media screen and (max-width: 1024px) {
          margin-left: 0;
        }

        &.scroll-reveal {
          &::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            height: 1px;
            width: 93%;
            background-color: $fontColor;
            transform-origin: left center;
            transform: scaleX(0);
            animation: none;
            will-change: transform;
          }

          &.active::after {
            animation: borderGrow 1.5s cubic-bezier(0.215, 0.61, 0.355, 1)
              forwards;
          }

          .button-container a.slide-fade-in {
            opacity: 0;
            transform: scale(0) rotate(-180deg);
            animation: none;
            will-change: transform, opacity;
          }

          &.active .button-container a.slide-fade-in {
            animation: scaleRotateIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)
              forwards;
            animation-delay: 0.8s;
          }
        }

        h2 {
          font-size: 15px;
          color: $mainColor;
          margin-bottom: 24px;
        }
        h1 {
          font-size: 21px;
          font-weight: 600;
          color: $fontColor;
          margin-bottom: 24px;
        }
        p {
          font-size: 15px;
          color: $articleColor;
          margin-bottom: 24px;
          text-align: justify;
          line-height: 1.8;
          display: -webkit-box;
          -webkit-line-clamp: 3;
          -webkit-box-orient: vertical;
          overflow: hidden;
          text-overflow: ellipsis;
          max-height: calc(15px * 2 * 2 + 40px);
          @media screen and (max-width: 1024px) {
            margin-bottom: 74px;
          }
        }
        .button-container {
          position: absolute;
          bottom: 0;
          right: 0;

          a {
            display: block;
            cursor: pointer;

            img {
              margin-bottom: -2%;
              display: block;
              width: 50px;
              @media screen and (max-width: 1024px) {
                width: 40px;
              }
            }
          }
        }
      }
    }
    &__content-r {
      display: flex;
      @media screen and (max-width: 1024px) {
        flex-direction: column;
        margin-left: 18px;
        margin-bottom: 0;
      }
      @media screen and (max-width: 768px) {
        margin-left: 0;
      }
      &-content {
        flex: 0 1 50%;
        margin-right: 32px;
        display: flex;
        flex-direction: column;
        position: relative;
        @media screen and (max-width: 1024px) {
