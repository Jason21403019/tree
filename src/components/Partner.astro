---
import ActionTitle from './ActionTitle.astro'
---

<section class="partner" id="partners">
  <div class="partner__container">
    <ActionTitle title="共好夥伴" />

    <div
      class="partner__container-area"
      data-aos="fade-up"
      data-aos-duration="1200"
      data-aos-delay="200">
      <div class="partner__container-area-item">
        <a
          href="https://www.secom.com.tw"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/secom.png" alt="secom" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://www.scsb.com.tw/"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/shanghai.png" alt="shanghai" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://www.mli.com.tw/sites/mliportal/home"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/mercuries.png" alt="mercuries" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://www.tlb.com.tw/"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/tlbiotech.png" alt="tlbiotech" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://www.medtecs.com/zh/"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/medtecs.png" alt="medtecs" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://www.cathayhotel.com.tw/"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/cathay.png" alt="cathay" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://www.kaleyxuan.com/"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/kaleyxuan.png" alt="kaleyxuan" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://www.bot.com.tw/"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/taiwanbank.png" alt="taiwanbank" />
        </a>
      </div>
      <div class="partner__container-area-item">
        <a
          href="https://recycle2.moenv.gov.tw/SingleUse/"
          target="_blank"
          rel="noopener noreferrer">
          <img src="./imgs/partner/resource.png" alt="resource" />
        </a>
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../style/_variable.scss' as *;
  .partner {
    width: 100%;
    margin-bottom: 228px;

    @media screen and (max-width: 1024px) {
      margin-bottom: 80px;
    }

    &__container {
      &-area {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 1fr);
        gap: 40px;
        @media screen and (max-width: 768px) {
          grid-template-columns: repeat(2, 1fr);
          grid-template-rows: repeat(4, 1fr);
          gap: 20px;
        }

        &-item {
          // overflow: hidden;

          a {
            display: block;
            width: 100%;
            height: 100%;
          }

          img {
            cursor: pointer;
            width: 100%;
            transition: transform 0.3s ease;
          }

          &:hover {
            img {
              transform: scale(1.1);
            }
          }
        }
      }
    }
  }
</style>
