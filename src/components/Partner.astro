<style lang="scss">
  @import '../style/_variable.scss';
  .partner {
    width: 100%;
    margin-bottom: 228px;
    &__container {
      h1 {
        font-size: 40px;
        font-weight: 700;
        color: $fontColor;
        margin-bottom: 40px;
        position: relative;
        &::before {
          content: '';
          position: absolute;
          top: -12px;
          left: 0;
          width: 40px;
          height: 6px;
          background-color: $pointColor;
        }
      }
      &-area {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(3, 1fr);
        gap: 40px;

        &-item {
          overflow: hidden;

          a {
            display: block;
            width: 100%;
            height: 100%;
          }

          img {
            cursor: pointer;
            width: 100%;
            transition: transform 0.3s ease;
          }

          &:hover {
            img {
              transform: scale(1.1);
            }
          }
        }
      }
    }
  }
</style>
