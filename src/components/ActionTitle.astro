---
interface Props {
  title: string
}
const { title } = Astro.props
---

<section class="actionTitle">
  <h1 data-aos="fade-up" data-aos-duration="1200">{title}</h1>
</section>

<style lang="scss">
  @import '../style/_variable.scss';

  .actionTitle {
    padding-top: 64px;
  }
  h1 {
    font-size: 40px;
    font-weight: 600;
    color: $fontColor;
    margin-bottom: 40px;
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: -6px;
      left: 0;
      width: 38px;
      height: 6px;
      background-color: $pointColor;
      animation: lineAnimate 2s infinite;
    }
    @media screen and (max-width: 1024px) {
      margin-bottom: 24px;
      font-size: 30px;
      &::before {
        width: 28px;
        animation: lineAnimateMobile 2s infinite;
      }
    }
  }
  @keyframes lineAnimate {
    0% {
      width: 0;
      opacity: 0.7;
    }
    100% {
      width: 38px;
      opacity: 1;
    }
  }
  @keyframes lineAnimateMobile {
    0% {
      width: 0;
      opacity: 0.7;
    }
    100% {
      width: 28px;
      opacity: 1;
    }
  }
</style>
