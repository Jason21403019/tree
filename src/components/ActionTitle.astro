---
interface Props {
  title: string
}
const { title } = Astro.props
---

<h1 data-aos="fade-up" data-aos-duration="1200">{title}</h1>

<style lang="scss">
  @import '../style/_variable.scss';

  h1 {
    font-size: 40px;
    font-weight: 700;
    color: $fontColor;
    margin-bottom: 40px;
    position: relative;
    @media screen and (max-width: 1024px) {
      margin-bottom: 24px;
      font-size: 30px;
    }
    &::before {
      content: '';
      position: absolute;
      top: -12px;
      left: 0;
      width: 40px;
      height: 6px;
      background-color: $pointColor;
      animation: lineAnimate 2s infinite;
    }
  }
  @keyframes lineAnimate {
    0% {
      width: 0;
      opacity: 0.7;
    }
    100% {
      width: 40px;
      opacity: 1;
    }
  }
</style>
