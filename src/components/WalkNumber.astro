---
import AnimatedCounter from './AnimatedCounter.astro'
---

<section class="walkNumber">
  <div class="walkNumber__container">
    <div class="walkNumber__content">
      <h2
        class="walkNumber__title"
        data-aos="flip-left"
        data-aos-duration="1500">
        與樹同行．走出一座健康森林<br />
        結合健走與植樹<br />
        共創環境與人類健康雙贏
      </h2>

      <div class="number__items">
        <div class="number__item">
          <p
            class="number__item-name"
            data-aos="fade-right"
            data-aos-duration="1500">
            累計
          </p>
          <AnimatedCounter target={100.5} duration={2000} decimals={1} />
          <p
            class="number__item-name2"
            data-aos="fade-left"
            data-aos-duration="1500">
            萬步
          </p>
        </div>
        <div class="number__item">
          <p
            class="number__item-name"
            data-aos="fade-right"
            data-aos-duration="1500">
            攜手種下
          </p>
          <AnimatedCounter target={3000} duration={2000} decimals={0} />
          <p
            class="number__item-name2"
            data-aos="fade-left"
            data-aos-duration="1500">
            棵樹
          </p>
        </div>
        <div class="number__item">
          <p
            class="number__item-name"
            data-aos="fade-right"
            data-aos-duration="1500">
            響應企業
          </p>
          <AnimatedCounter target={7} duration={2500} decimals={0} />
          <p
            class="number__item-name2"
            data-aos="fade-left"
            data-aos-duration="1500">
            家
          </p>
        </div>
        <div class="number__item">
          <p
            class="number__item-name"
            data-aos="fade-right"
            data-aos-duration="1500">
            超過
          </p>
          <AnimatedCounter target={2000} duration={2000} decimals={0} />
          <p
            class="number__item-name2"
            data-aos="fade-left"
            data-aos-duration="1500">
            人參與
          </p>
        </div>
      </div>
    </div>
    <div class="trees">
      <img src="./imgs/trees.png" alt="Trees Image" />
    </div>
  </div>
</section>

<style lang="scss">
  @use '../style/_variable.scss' as *;
  .walkNumber {
    &__container {
      padding-top: 112px;
      background-color: $BGColor;
      @media screen and (min-width: 1024px) {
        padding: 112px 24px 0 24px;
      }
    }

    &__content {
      max-width: 1300px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
      @media screen and (max-width: 480px) {
        padding: 0 24px;
      }
      h2 {
        font-size: 30px;
        color: $fontColor;
        text-align: center;
        margin-bottom: 53px;
        font-weight: 600;
        line-height: 2;
        @media screen and (max-width: 480px) {
          font-size: 20px;
        }
      }
      .number__items {
        display: flex;
        justify-content: center;
        gap: 54px;
        margin-bottom: 154px;
        @media screen and (max-width: 1110px) {
          gap: 24px;
        }
        @media screen and (max-width: 1024px) {
          flex-wrap: wrap;
          gap: 100px;
          max-width: 700px;
          margin-left: auto;
          margin-right: auto;
          margin-bottom: 54px;
        }
        @media screen and (max-width: 480px) {
          gap: 30px;
        }
        .number__item {
          width: 320px;
          @media screen and (max-width: 1366px) {
            width: 260px;
          }
          &-name {
            position: relative;
            font-size: 20px;
            color: $fontColor;
            padding-bottom: 16px;
            padding-left: 16px;
            border-bottom: 1px solid $fontColor;
            &::before {
              content: '';
              position: absolute;
              left: 0;
              top: 5px;
              width: 6px;
              height: 46%;
              background-color: $pointColor;
            }
          }
          &-name2 {
            text-align: right;
            margin-top: 12px;
            font-size: 28px;
            font-weight: 600;
            color: $fontColor;
          }
        }
      }
    }
    .trees {
      width: 100%;
      overflow: hidden;
      @media screen and (max-width: 768px) {
        padding: 0 4px;
      }
      img {
        width: 100%;
        @media screen and (max-width: 480px) {
          width: 236%;
        }
      }
    }
  }
</style>
