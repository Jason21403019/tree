---

<section class="actionInfo">
  <div class="actionInfo__container">
    <div
      class="actionInfo__container-time infos"
      data-aos="fade-up"
      data-aos-duration="1200">
      <h4>活動時間</h4>
      <p>2025年4月29日（二）13:00-15:00</p>
    </div>
    <div
      class="actionInfo__container-location infos"
      data-aos="fade-up"
      data-aos-duration="1200">
      <h4>集合地點</h4>
      <p>茄萣公14入口處，步行至活動旗幟所在位置</p>
    </div>
    <div
      class="actionInfo__container-trans infos"
      data-aos="fade-up"
      data-aos-duration="1200">
      <h4>交通方式</h4>
      <h5>搭乘高鐵</h5>
      <div class="actionInfo__container-trans-method">
        <div class="method__item1">
          <h3 class="method__item1-title1">高鐵</h3>
          <p class="method__item1-content1">台南站</p>
        </div>
        <div class="method__item2">
          <p class="method__item2-title2">轉乘計程車</p>
          <p class="method__item2-content2">約30分鐘</p>
        </div>
        <div class="method__item3">
          <p class="method__item3-title3">
            <span style="font-size: 16px;">集合地點</span>
            <br />茄萣公14入口處
          </p>
        </div>
      </div>
    </div>
    <div
      class="actionInfo__container-drive infos"
      data-aos="fade-up"
      data-aos-duration="1200">
      <h5>自行開車</h5>
      <p class="actionInfo__container-drive-content">
        可停放茄萣濕地遊客中心旁停車場
      </p>
      <span
        style="font-size: 16px; color: #ff0000; font-weight: 600; line-height: 1.5;">
        *本活動採邀請制，不對外開放</span
      >
    </div>
  </div>
</section>

<style lang="scss">
  @use '../style/_variable.scss' as *;
  .actionInfo {
    width: 100%;
    background: $whiteColor;
    padding-bottom: 90px;
    @media screen and (max-width: 480px) {
      padding-bottom: 0px;
    }
    &__container {
      .infos {
        h4 {
          font-size: 25px;
          font-weight: 600;
          color: $fontColor;
          margin-bottom: 12px;
          @media screen and (max-width: 480px) {
            font-size: 22px;
          }
        }
        p {
          font-size: 20px;
          color: $fontColor;
          @media screen and (max-width: 480px) {
            font-size: 18px;
          }
        }
        h5 {
          font-size: 20px;
          color: $fontColor;
          font-weight: 600;
          margin-bottom: 12px;
        }
      }
      &-time {
        margin-bottom: 36px;
      }
      &-location {
        margin-bottom: 36px;
      }
      &-trans {
        margin-bottom: 28px;
        &-method {
          display: flex;

          .method__item1 {
            padding: 40px 50px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: $fontColor;
            border-top-left-radius: 20px;
            @media screen and (max-width: 745px) {
              padding: 40px 10px;
            }
            @media screen and (max-width: 350px) {
              justify-content: center;
              padding: 20px 3px;
            }
            &-title1 {
              font-size: 16px;
              color: $whiteColor;
            }
            &-content1 {
              font-size: 20px;
              color: $whiteColor !important;
              @media screen and (max-width: 480px) {
                font-size: 18px !important;
              }
              @media screen and (max-width: 445px) {
                font-size: 16px !important;
              }
            }
          }
          .method__item2 {
            padding: 40px 80px;
            display: flex;
            flex-direction: column;
            position: relative;
            align-items: center;
            @media screen and (max-width: 850px) {
              padding: 40px 30px;
            }
            @media screen and (max-width: 460px) {
              padding: 40px 10px;
            }
            @media screen and (max-width: 375px) {
              padding: 40px 5px;
            }
            @media screen and (max-width: 350px) {
              padding: 20px 3px;
              justify-content: center;
            }
            &::before {
              position: absolute;
              content: '';
              top: 50%;
              left: 50%;
              height: 1px;
              width: 100%;
              transform: translateX(-50%);
              background-color: $fontColor;
            }
            &-title2 {
              font-size: 20px;
              margin-bottom: 4px;
              @media screen and (max-width: 480px) {
                font-size: 18px !important;
              }
              @media screen and (max-width: 445px) {
                font-size: 16px !important;
              }
            }
            &-content2 {
              font-size: 20px;
              margin-top: 4px;
              @media screen and (max-width: 480px) {
                font-size: 18px !important;
              }
              @media screen and (max-width: 445px) {
                font-size: 16px !important;
              }
            }
          }
          .method__item3 {
            padding: 40px 30px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 1px solid $fontColor;
            border-top-left-radius: 20px;
            @media screen and (max-width: 745px) {
              padding: 40px 10px;
            }
            @media screen and (max-width: 445px) {
              max-width: 204px;
            }
            @media screen and (max-width: 350px) {
              justify-content: center;
              padding: 20px 3px;
            }
            &-title3 {
              font-size: 20px;
              text-align: center;
              @media screen and (max-width: 480px) {
                font-size: 18px !important;
              }
              @media screen and (max-width: 445px) {
                text-align: center;
                font-size: 16px !important;
              }
            }
          }
        }
      }
      &-drive {
        &-content {
          margin-bottom: 16px;
        }
      }
    }
  }
</style>
