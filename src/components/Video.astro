---
import ActionTitle from './ActionTitle.astro'
---

<section class="video" id="video">
  <div class="video__container">
    <ActionTitle title="實踐行動" />
    <div
      class="video__area"
      data-aos="fade-up"
      data-aos-duration="1200"
      data-aos-delay="200">
      <iframe
        width="100%"
        height="100%"
        src="https://www.youtube.com/embed/ZdsJBAqHlzA?si=V-JbNnVQ9zki2k4v"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../style/_variable.scss' as *;
  .video {
    width: 100%;
    margin-bottom: 150px;
    @media screen and (max-width: 1024px) {
      margin-bottom: 60px;
    }
    @media screen and (max-width: 480px) {
      margin-bottom: 40px;
    }

    &__container {
      width: 100%;
    }
    &__area {
      width: 100%;
      height: 591px;
      @media screen and (max-width: 1024px) {
        height: 400px;
      }
      @media screen and (max-width: 880px) {
        height: 300px;
      }
      @media screen and (max-width: 480px) {
        height: 200px;
      }
      @media screen and (max-width: 414px) {
        height: 170px;
      }
      @media screen and (max-width: 360px) {
        height: 150px;
      }
    }
  }
</style>
