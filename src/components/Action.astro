---
import ActionTitle from './ActionTitle.astro'
import ActionInfo from './ActionInfo.astro'
import Video from './Video.astro'
import ArticleLink from './ArticleLink.astro'
import Partner from './Partner.astro'
import Footer from './Footer.astro'
---

<section class="action" id="action">
  <div class="action__container">
    <ActionTitle title="實踐行動" />
    <div class="action__container-area">
      <div class="action__container-maps">
        <div class="action__container-maps-info">
          <h4 data-aos="fade-up" data-aos-duration="1200">2025</h4>
          <h2 data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200">
            高雄茄萣濕地
          </h2>
          <p data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400">
            茄萣濕地擁有豐富生態，是保育鳥類黑面琵鷺的重要度冬棲地；然而，位於南邊的公15用地因與海水相連，正面臨土壤鹽化的挑戰，以及外來樹種銀合歡與巴西乳香的威脅。透過植樹造林，可以提升生態豐富度，營造多元地貌，讓沿岸生物的棲息地有更多選擇。
          </p>
          <a
            data-aos="fade-up"
            data-aos-duration="1200"
            href="https://maps.app.goo.gl/bs1BNv2vZLsxVEKe7"
            >Google map<img src="./imgs/seemore.svg" alt="seemorebtn" /></a
          >
        </div>
      </div>
      <div
        class="action__container-map"
        data-aos="fade-up"
        data-aos-duration="1200"
        data-aos-delay="600">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3675.812726761056!2d120.1976713!3d22.883375399999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x346e0b547b1dea33%3A0x105ae16a111ca50b!2z6auY6ZuE5biC6IyE6JCj5Y2A5r-V5Zyw6YGK5a6i5Lit5b-D!5e0!3m2!1szh-TW!2stw!4v1741070690001!5m2!1szh-TW!2stw"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
    <ActionInfo />
    <Video />
    <ArticleLink />
    <Partner />
    <Footer />
  </div>
</section>

<style lang="scss">
  @import '../style/_variable.scss';

  .action {
    width: 100%;
    background: $whiteColor;
    padding-top: 64px;
    margin-top: -0.4%;
    @media screen and (max-width: 1280px) {
      padding: 64px 100px;
    }
    @media screen and (max-width: 640px) {
      padding: 64px 24px 24px 24px;
    }
    &__container {
      max-width: 1050px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;

      &-area {
        display: flex;
        gap: 30px;
        margin-bottom: 64px;
        @media screen and (max-width: 1024px) {
          flex-direction: column;
          gap: 0;
        }
      }
      &-maps {
        display: flex;
        flex-direction: column;
        &-info {
          color: $fontColor;
          h4 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 12px;
            @media screen and (max-width: 1024px) {
              margin-bottom: 24px;
            }
          }
          h2 {
            font-size: 35px;
            font-weight: 600;
            margin-bottom: 46px;
            @media screen and (max-width: 1024px) {
              margin-bottom: 12px;
            }
          }
          p {
            font-size: 20px;
            text-align: justify;
            line-height: 2;
            margin-bottom: 128px;
            @media screen and (max-width: 1024px) {
              margin-bottom: 20px;
            }
          }
          a {
            font-size: 20px;
            color: $fontColor;
            text-decoration: none;
            display: flex;
            align-items: center;
            @media screen and (max-width: 1024px) {
              margin-bottom: 20px;
            }
            img {
              width: 28px;
              height: 28px;
              margin-left: 18px;
            }
          }
        }
      }
      &-map {
        width: 510px;
        height: 470px;
        flex-shrink: 0;
        @media screen and (max-width: 1024px) {
          width: 100%;
          height: 400px;
        }
        iframe {
          width: 100%;
          height: 100%;
          filter: grayscale(100%);
          transition: filter 0.3s ease;
          object-fit: cover;
          @media screen and (max-width: 1024px) {
            filter: grayscale(0%);
          }
        }
        &:hover {
          iframe {
            filter: grayscale(0%);
          }
        }
      }
    }
  }
</style>
