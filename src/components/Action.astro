---
import ActionInfo from './ActionInfo.astro'
import Video from './Video.astro'
---

<section class="action">
  <div class="action__container">
    <h1 class="action__container-title">實踐行動</h1>
    <div class="action__container-area">
      <div class="action__container-maps">
        <div class="action__container-maps-info">
          <h4>2025</h4>
          <h2>高雄茄萣濕地</h2>
          <p>
            茄萣濕地擁有豐富生態，是保育鳥類黑面琵鷺的重要度冬棲地；然而，位於南邊的公15用地因與海水相連，正面臨土壤鹽化的挑戰，以及外來樹種銀合歡與巴西乳香的威脅。透過植樹造林，可以提升生態豐富度，營造多元地貌，讓沿岸生物的棲息地有更多選擇。
          </p>
          <a href="https://maps.app.goo.gl/bs1BNv2vZLsxVEKe7"
            >Google map<img
              src="/public/imgs/seemore.png"
              alt="seemorebtn"
            /></a
          >
        </div>
      </div>
      <div class="action__container-map">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3675.812726761056!2d120.1976713!3d22.883375399999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x346e0b547b1dea33%3A0x105ae16a111ca50b!2z6auY6ZuE5biC6IyE6JCj5Y2A5r-V5Zyw6YGK5a6i5Lit5b-D!5e0!3m2!1szh-TW!2stw!4v1741070690001!5m2!1szh-TW!2stw"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
    <ActionInfo />
    <Video />
  </div>
</section>

<style lang="scss">
  @import '../style/_variable.scss';

  .action {
    width: 100%;
    background: $whiteColor;
    padding-top: 64px;
    margin-top: -0.4%;
    &__container {
      max-width: 1050px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      &-title {
        font-size: 40px;
        font-weight: 700;
        color: $fontColor;
        margin-bottom: 40px;
        position: relative;
        &::before {
          content: '';
          position: absolute;
          top: -12px;
          left: 0;
          width: 40px;
          height: 6px;
          background-color: $pointColor;
        }
      }
      &-area {
        display: flex;
        gap: 30px;
      }
      &-maps {
        display: flex;
        flex-direction: column;
        &-info {
          color: $fontColor;
          h4 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 12px;
          }
          h2 {
            font-size: 35px;
            font-weight: 700;
            margin-bottom: 46px;
          }
          p {
            font-size: 20px;
            text-align: justify;
            line-height: 2;
            margin-bottom: 128px;
          }
          a {
            font-size: 20px;
            color: $fontColor;
            text-decoration: none;
            display: flex;
            align-items: center;
            img {
              width: 28px;
              height: 28px;
              margin-left: 18px;
            }
          }
        }
      }
      &-map {
        width: 510px;
        height: 470px;
        flex-shrink: 0;
        iframe {
          width: 100%;
          height: 100%;
          filter: grayscale(100%);
          transition: filter 0.3s ease;
          object-fit: cover;
        }
        &:hover {
          iframe {
            filter: grayscale(0%);
          }
        }
      }
    }
  }
</style>
