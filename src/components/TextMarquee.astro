<style lang="scss">
  @use '../style/_variable.scss' as *;
  .text-marquee {
    width: 100vw;
    position: relative;
    left: calc(50% - 50vw);
    transform: translateX(0);
    overflow: hidden;

    &__container {
      width: 100%;
      max-width: 1920px;
      margin: 0 auto;
      position: relative;
      overflow: hidden;
    }

    &__content {
      position: relative;
      width: 100%;
      padding-bottom: 20px;
      height: clamp(130px, 10vw, 320px);
      display: flex;
      align-items: center;
      overflow: hidden;
    }

    &__inner {
      display: flex;
      position: absolute;
      white-space: nowrap;
      will-change: transform;
      animation: marquee 65s linear infinite;
    }

    &__title {
      font-size: clamp(100px, 10vw, 300px);
      font-weight: 900;
      padding: 0 2rem;
      color: $mainColor;
      line-height: 1;
    }
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 1rem));
    }
  }
</style>
