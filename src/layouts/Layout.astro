---
import AOSInit from '../components/AOSInit.astro'
import Scrolling from '../components/Scrolling.astro'
import GTM from '../components/meta/GTM.astro'
import Datalayer from '../components/meta/Datalayer.astro'
import ComScoreTag from '../components/meta/ComScore_Tag.astro'
import GTMNoscript from '../components/meta/GTM_noscript.astro'
import GoogleFont from '../components/font/GoogleFont.astro'
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="./imgs/udn.ico" />
    <meta property="og:title" content="與樹同行 走出一座健康森林" />
    <meta
      name="description"
      content="健康的森林，是多元物種成長的棲地。健康的身心，是我們賴以維生的基底。今年4月，世界地球日55週年，聯合線上發起「與樹同行．走出一座健康森林」行動，結合植樹與健走，共創環境與人類健康的雙贏，為島嶼永續邁出穩健每一步。"
    />
    <meta
      property="og:description"
      content="健康的森林，是多元物種成長的棲地。健康的身心，是我們賴以維生的基底。今年4月，世界地球日55週年，聯合線上發起「與樹同行．走出一座健康森林」行動，結合植樹與健走，共創環境與人類健康的雙贏，為島嶼永續邁出穩健每一步。"
    />
    <meta
      name="keywords"
      content="永續、環境、生物多樣性、森林、樹、種樹、植樹、生態、世界地球日、健走、運動、健康、職場健康、茄萣濕地
"
    />
    <meta property="og:image" content="./imgs/meta.png" />
    <meta
      property="og:url"
      content="https://udn.com/upf/ubrand/2025_data/walkfortrees/"
    />
    <ComScoreTag />
    <Datalayer />
    <GTM />
    <GoogleFont />
    <title>walkfortrees</title>
  </head>
  <body>
    <GTMNoscript />
    <div class="content-container" data-scroll>
      <AOSInit />
      <Scrolling />
      <slot />
    </div>
  </body>
</html>

<style lang="scss" is:global>
  @import '../style/main.scss';
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: $font-noto;
    width: 100%;
    max-width: 1920px;
    background: $webBGColor;
    scroll-padding-top: 64px;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }
  .content-container {
    width: 100%;
    margin: 0 auto;
    padding: 0;
    @media screen and (min-width: 1279px) {
      width: 92% !important;
      max-width: 1765px;
    }
  }
</style>
