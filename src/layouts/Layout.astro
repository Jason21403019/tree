---
import '../style/main.scss'
import AOSInit from '../components/AOSInit.astro'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/public/imgs/udn.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Gothic+A1&family=Noto+Sans+TC:wght@100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>Planttrees2025</title>
  </head>
  <body>
    <div class="content-container">
      <AOSInit />
      <slot />
    </div>
  </body>
</html>

<style lang="scss" is:global>
  @import '../style/_variable.scss';
  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: $font-noto;
    width: 100%;
    max-width: 1920px;
    background: $webBGColor;
  }
  .content-container {
    max-width: 1765px;
    width: 100%;
    margin: 0 auto;
    padding: 0;
  }
</style>
